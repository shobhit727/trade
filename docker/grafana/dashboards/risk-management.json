{
  "dashboard": {
    "title": "Cryptobot - Risk Management",
    "tags": ["cryptobot", "risk"],
    "timezone": "utc",
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Portfolio Exposure %",
        "type": "gauge",
        "targets": [
          {
            "expr": "cryptobot_risk_exposure_pct{strategy=\"portfolio\"} * 100",
            "legendFormat": "Exposure"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "orange", "value": 70},
                {"color": "red", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Daily Loss %",
        "type": "gauge",
        "targets": [
          {
            "expr": "cryptobot_risk_daily_loss_pct{strategy=\"portfolio\"} * 100",
            "legendFormat": "Daily Loss"
          }
        ],
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": -20,
            "max": 5,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": -2},
                {"color": "orange", "value": -5},
                {"color": "red", "value": -10}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Current Drawdown %",
        "type": "gauge",
        "targets": [
          {
            "expr": "cryptobot_risk_drawdown_pct * 100",
            "legendFormat": "Drawdown"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 30,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "orange", "value": 10},
                {"color": "red", "value": 15}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Kill Switch",
        "type": "stat",
        "targets": [
          {
            "expr": "cryptobot_risk_kill_switch_active",
            "legendFormat": "Kill Switch"
          }
        ],
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "INACTIVE", "color": "green"}, "1": {"text": "ACTIVE", "color": "red"}}}
            ]
          }
        }
      },
      {
        "id": 5,
        "title": "Exposure by Strategy",
        "type": "bargauge",
        "targets": [
          {
            "expr": "cryptobot_risk_exposure_pct * 100",
            "legendFormat": "{{strategy}}"
          }
        ],
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 6,
        "title": "Position Concentration",
        "type": "timeseries",
        "targets": [
          {
            "expr": "cryptobot_position_concentration_pct * 100",
            "legendFormat": "{{strategy}}"
          }
        ],
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 20}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Strategy Correlations",
        "type": "table",
        "targets": [
          {
            "expr": "cryptobot_risk_correlation",
            "legendFormat": "{{strategy_a}} x {{strategy_b}}",
            "format": "table"
          }
        ],
        "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 0.7}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Daily PnL by Strategy",
        "type": "timeseries",
        "targets": [
          {
            "expr": "cryptobot_daily_pnl_usd",
            "legendFormat": "{{strategy}}"
          }
        ],
        "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 9,
        "title": "Position Sizes",
        "type": "table",
        "targets": [
          {
            "expr": "cryptobot_position_size_usd",
            "legendFormat": "{{strategy}} {{symbol}} {{side}}",
            "format": "table"
          }
        ],
        "gridPos": {"x": 0, "y": 22, "w": 12, "h": 10},
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 10,
        "title": "Unrealized PnL by Position",
        "type": "table",
        "targets": [
          {
            "expr": "cryptobot_position_pnl_unrealized_usd",
            "legendFormat": "{{strategy}} {{symbol}}",
            "format": "table"
          }
        ],
        "gridPos": {"x": 12, "y": 22, "w": 12, "h": 10},
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 11,
        "title": "Risk Limits",
        "type": "table",
        "targets": [
          {
            "expr": "cryptobot_risk_exposure_pct{strategy=\"portfolio\"}",
            "legendFormat": "Max Total Exposure",
            "format": "table"
          },
          {
            "expr": "cryptobot_position_concentration_pct{strategy=\"portfolio\"}",
            "legendFormat": "Max Single Position",
            "format": "table"
          },
          {
            "expr": "cryptobot_risk_daily_loss_pct{strategy=\"portfolio\"}",
            "legendFormat": "Max Daily Loss",
            "format": "table"
          },
          {
            "expr": "cryptobot_risk_drawdown_pct",
            "legendFormat": "Max Drawdown",
            "format": "table"
          }
        ],
        "gridPos": {"x": 0, "y": 32, "w": 24, "h": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}