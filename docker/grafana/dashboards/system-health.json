{
  "dashboard": {
    "title": "Cryptobot - System Health",
    "tags": ["cryptobot", "system", "health"],
    "timezone": "utc",
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "System Uptime",
        "type": "stat",
        "targets": [
          {
            "expr": "cryptobot_system_uptime_seconds",
            "legendFormat": "Uptime"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 60}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "CPU Usage %",
        "type": "gauge",
        "targets": [
          {
            "expr": "cryptobot_system_cpu_percent",
            "legendFormat": "CPU"
          }
        ],
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Memory Usage %",
        "type": "gauge",
        "targets": [
          {
            "expr": "cryptobot_system_memory_bytes{type=\"used\"} / cryptobot_system_memory_bytes{type=\"total\"} * 100",
            "legendFormat": "Memory"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Disk Usage %",
        "type": "gauge",
        "targets": [
          {
            "expr": "cryptobot_system_disk_percent",
            "legendFormat": "{{mount}}"
          }
        ],
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Connection Status",
        "type": "table",
        "targets": [
          {
            "expr": "cryptobot_connection_status",
            "legendFormat": "{{component}} {{endpoint}}",
            "format": "table"
          }
        ],
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DISCONNECTED", "color": "red"}, "1": {"text": "CONNECTED", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 6,
        "title": "Connection Latency (p95)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(cryptobot_connection_latency_seconds_bucket[5m]))",
            "legendFormat": "{{component}} {{endpoint}}"
          }
        ],
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 2.0}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Errors Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(cryptobot_errors_total[5m])",
            "legendFormat": "{{component}} {{error_type}}"
          }
        ],
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 8,
        "title": "Warnings Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(cryptobot_warnings_total[5m])",
            "legendFormat": "{{component}} {{warning_type}}"
          }
        ],
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 9,
        "title": "Market Data Messages Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(cryptobot_market_data_messages_total[5m])",
            "legendFormat": "{{source}} {{symbol}} {{type}}"
          }
        ],
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 10,
        "title": "Market Data Gaps",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(cryptobot_market_data_gaps_total[5m])",
            "legendFormat": "{{source}} {{symbol}}"
          }
        ],
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 11,
        "title": "Market Data Staleness",
        "type": "timeseries",
        "targets": [
          {
            "expr": "cryptobot_market_data_staleness_seconds",
            "legendFormat": "{{source}} {{symbol}}"
          }
        ],
        "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 30}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Strategy Signal Latency (p95)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(cryptobot_strategy_signal_latency_seconds_bucket[5m]))",
            "legendFormat": "{{strategy}}"
          }
        ],
        "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.1},
                {"color": "red", "value": 1.0}
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "title": "ML Inference Latency (p95)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(cryptobot_ml_inference_latency_seconds_bucket[5m]))",
            "legendFormat": "{{model}} {{type}}"
          }
        ],
        "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.05},
                {"color": "red", "value": 0.2}
              ]
            }
          }
        }
      },
      {
        "id": 14,
        "title": "Backtest Runs",
        "type": "table",
        "targets": [
          {
            "expr": "rate(cryptobot_backtest_runs_total[5m])",
            "legendFormat": "{{strategy}} {{status}}",
            "format": "table"
          }
        ],
        "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}