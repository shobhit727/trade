# Copy to .env and adjust. Everything optional — sane paper defaults apply.
BOT_STRATEGY=dual_ma
BOT_SYMBOL=BTCUSDT
BOT_TIMEFRAME=1d
BOT_PROFILE=realistic
BOT_MODE=paper
BOT_PORT=8081
BOT_PARAMS={"fast":5,"slow":50}

# Alerts (optional)
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=

# Exchange keys (live only; never commit real keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=
