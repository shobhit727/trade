# syntax=docker/dockerfile:1.7
# Research/analysis image. pandas/numpy/scipy/pyarrow all ship manylinux wheels,
# so no compiler toolchain is required (keeps the image small and the build fast).
FROM python:3.14-slim AS research

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements/research.txt /app/requirements/research.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/requirements/research.txt

COPY src /app/src
COPY research /app/research

CMD ["python", "research/audit_data.py"]